# Copy to .env and adjust. All optional.

# Where videos, clips, the database and downloaded models live.
AUTOREEL_DATA_DIR=data
AUTOREEL_HOST=127.0.0.1
AUTOREEL_PORT=8000

# Protect the UI/API with HTTP basic auth (user: admin). Set this if you expose the app via a tunnel.
AUTOREEL_ADMIN_PASSWORD=

# Public HTTPS URL of this app (e.g. a Cloudflare tunnel). Needed for the TikTok OAuth redirect and
# for Instagram "video_url" uploads with Instagram-login tokens.
AUTOREEL_PUBLIC_BASE_URL=

# LLM keys (can also be entered in Settings in the UI)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
