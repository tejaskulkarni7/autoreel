# Copy to .env and fill in. With docker-compose.yml, DOMAIN and AUTOREEL_ADMIN_PASSWORD are required.

# --- Deployment (docker-compose.yml) ---------------------------------------------------
# Domain pointing at your server (A/AAAA record). Caddy gets a free HTTPS certificate for it.
DOMAIN=clips.example.com
# Password for the web UI (user name: admin). Use a long random string.
AUTOREEL_ADMIN_PASSWORD=
# Include the optional browser-automation TikTok uploader in the image (true/false).
TIKTOK_BROWSER=false

# --- AI ---------------------------------------------------------------------------------
# Claude API key for picking clips (can also be entered in Settings). Not needed with Ollama.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Running without Docker (autoreel serve) -------------------------------------------
# AUTOREEL_DATA_DIR=data
# AUTOREEL_HOST=127.0.0.1
# AUTOREEL_PORT=8000
# Public HTTPS URL of this app (a domain or a Cloudflare tunnel). Needed for the TikTok OAuth
# redirect and Instagram "video_url" uploads. Set automatically from DOMAIN in docker-compose.yml.
# AUTOREEL_PUBLIC_BASE_URL=
